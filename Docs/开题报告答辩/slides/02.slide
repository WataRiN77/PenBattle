<Slide style={{ width: '1280px', height: '720px', background: '#FFFFFF', padding: 0 }}>
    <Box style={{ width: '100%', height: 72, background: '#1E4FA8', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 40, paddingRight: 40 }}>
        <Text style={{ fontSize: 28, fontWeight: 'bold', color: '#FFFFFF' }}>目录</Text>
        <Text style={{ fontSize: 16, color: '#B9CEF0' }}>Contents</Text>
    </Box>

    <Box style={{ width: '100%', height: 588, background: '#F7F9FC', padding: 28, gap: 16 }}>
        <Box style={{ flexDirection: 'row', gap: 16, flex: 1 }}>
            <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 6, padding: 20, gap: 8 }}>
                <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1E4FA8' }}>01 研究课题</Text>
                <Text style={{ fontSize: 20, color: '#4A5568', lineHeight: 1.5 }}>论题选择：课题 ≠ 项目<br />研究问题与验证方式</Text>
            </Box>
            <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 6, padding: 20, gap: 8 }}>
                <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1E4FA8' }}>02 背景与意义</Text>
                <Text style={{ fontSize: 20, color: '#4A5568', lineHeight: 1.5 }}>物理驱动玩法<br />派对合作案例<br />构筑玩法与策略深度</Text>
            </Box>
            <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 6, padding: 20, gap: 8 }}>
                <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1E4FA8' }}>03 技术基础</Text>
                <Text style={{ fontSize: 20, color: '#4A5568', lineHeight: 1.5 }}>确定性物理<br />网络同步既有方案<br />本研究的切入点</Text>
            </Box>
        </Box>

        <Box style={{ flexDirection: 'row', gap: 16, flex: 1 }}>
            <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 6, padding: 20, gap: 8 }}>
                <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1E4FA8' }}>04 研究内容</Text>
                <Text style={{ fontSize: 20, color: '#4A5568', lineHeight: 1.5 }}>技术探索（主）<br />设计模式探索（辅）<br />产品设计（支撑）</Text>
            </Box>
            <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 6, padding: 20, gap: 8 }}>
                <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1E4FA8' }}>05 创新与成果</Text>
                <Text style={{ fontSize: 20, color: '#4A5568', lineHeight: 1.5 }}>三点创新<br />AI 辅助开发实证<br />预期成果与评估</Text>
            </Box>
            <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 6, padding: 20, gap: 8 }}>
                <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1E4FA8' }}>06 计划与风险</Text>
                <Text style={{ fontSize: 20, color: '#4A5568', lineHeight: 1.5 }}>分阶段里程碑<br />主要风险与应对<br />致谢与问答</Text>
